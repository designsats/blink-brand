{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Blink design tokens. Single source of truth. Generated from the 2023 brand book, app/rne-theme/colors.ts and blink.sv, with conflicts resolved 2026-07-25.",
  "color": {
    "$type": "color",
    "brand": {
      "orange":  { "$value": "#f18a00", "$description": "Bitcoin orange. Pantone 144 C. Logo, print, gradient." },
      "sunset":  { "$value": "#fb5607", "$description": "Sunset orange. Pantone Orange 021 C. Gradient, large fills." },
      "yellow":  { "$value": "#ffbe0b", "$description": "Lightning yellow. Pantone 123 C. Gradient, highlights." },
      "blue":    { "$value": "#5D78DA", "$description": "Blink blue. Brand surfaces only; not present in the app." },
      "black":   { "$value": "#000000", "$description": "Venta black. Pantone Process Black. Wordmark and print only." }
    },
    "accent": {
      "light":     { "$value": "#fc5805", "$description": "UI interaction color, light mode." },
      "dark":      { "$value": "#ffad0d", "$description": "UI interaction color, dark mode." },
      "turquoise": { "$value": "#3de8f4", "$description": "Pantone 3105 C. Illustration and data-viz ONLY. Never UI, type, backgrounds or buttons." }
    },
    "feedback": {
      "error":      { "$value": "#DC2626" },
      "error-bg":   { "$value": "#FEE2E2", "$description": "Light mode. Dark mode: #7F1D1D" },
      "warning":    { "$value": "#F59E0B", "$description": "NEVER used as text — fails contrast at all sizes on white." },
      "warning-bg": { "$value": "#FFF9E5" },
      "success":    { "$value": "#00A700" }
    },
    "light": {
      "bg-default":     { "$value": "#FFFFFF" },
      "bg-surface":     { "$value": "#F2F2F4" },
      "bg-raised":      { "$value": "#E7E7E7" },
      "text-primary":   { "$value": "#1d1d1d" },
      "text-secondary": { "$value": "#3A3C51" },
      "text-muted":     { "$value": "#9292A0", "$description": "3.07:1 on white — fails body contrast. Secondary labels only." },
      "border":         { "$value": "#E2E2E4" },
      "backdrop":       { "$value": "rgba(0, 0, 0, 0.06)" }
    },
    "dark": {
      "bg-default":     { "$value": "#1d1d1d", "$description": "Not pure black. #000000 is reserved for the wordmark and print." },
      "bg-surface":     { "$value": "#2B2B2B" },
      "bg-raised":      { "$value": "#393939" },
      "text-primary":   { "$value": "#FAF9F9" },
      "text-secondary": { "$value": "#E9E8E8" },
      "text-muted":     { "$value": "#949494" },
      "border":         { "$value": "#393939" },
      "backdrop":       { "$value": "rgba(255, 255, 255, 0.06)" }
    }
  },
  "gradient": {
    "blink": {
      "$type": "gradient",
      "$value": "linear-gradient(45deg, #ffbe0b, #fb5607)",
      "$description": "The only Blink gradient. Yellow bottom-left to sunset orange top-right, 45 degrees. Body copy never sits on it; headline text on it is always Venta black."
    }
  },
  "font": {
    "$type": "fontFamily",
    "brand":    { "$value": ["IBM Plex Sans", "system-ui", "sans-serif"], "$description": "Decks, web, social, print, docs." },
    "product":  { "$value": ["Source Sans Pro", "system-ui", "sans-serif"], "$description": "The Blink mobile app only." },
    "logotype": { "$value": ["Ubuntu"], "$description": "Bold Italic. Logo artwork only — never set by hand." }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "light":    { "$value": 300, "$description": "20px and above only." },
    "regular":  { "$value": 400 },
    "medium":   { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold":     { "$value": 700 }
  },
  "typography": {
    "$type": "typography",
    "$description": "Brand surfaces. Scale taken from the live blink.sv stylesheet.",
    "display": { "$value": { "fontFamily": "IBM Plex Sans", "fontSize": "68px", "lineHeight": "1.0em",  "fontWeight": 700 } },
    "h1":      { "$value": { "fontFamily": "IBM Plex Sans", "fontSize": "38px", "lineHeight": "1.15em", "fontWeight": 700 } },
    "h2":      { "$value": { "fontFamily": "IBM Plex Sans", "fontSize": "24px", "lineHeight": "1.2em",  "fontWeight": 700 } },
    "h3":      { "$value": { "fontFamily": "IBM Plex Sans", "fontSize": "20px", "lineHeight": "1.3em",  "fontWeight": 500 } },
    "body":    { "$value": { "fontFamily": "IBM Plex Sans", "fontSize": "16px", "lineHeight": "1.5em",  "fontWeight": 400 } },
    "small":   { "$value": { "fontFamily": "IBM Plex Sans", "fontSize": "14px", "lineHeight": "1.4em",  "fontWeight": 400 } }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "Seven values only. Larger gaps multiply the top of the scale: 30 -> 60 -> 90 -> 120.",
    "1": { "$value": "3px" },
    "2": { "$value": "5px" },
    "3": { "$value": "8px" },
    "4": { "$value": "10px" },
    "5": { "$value": "14px" },
    "6": { "$value": "20px" },
    "7": { "$value": "30px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Three values only. Blink buttons are always full.",
    "sm":   { "$value": "8px",   "$description": "Chips, inputs, small cards, thumbnails." },
    "lg":   { "$value": "16px",  "$description": "Cards, modals, panels, image crops." },
    "full": { "$value": "999px", "$description": "Buttons, pills, avatars, toggles." }
  },
  "shadow": {
    "$type": "shadow",
    "light": { "$value": "0 5px 20px rgba(0,0,0,0.10)" },
    "dark":  { "$value": "0 5px 20px rgba(0,0,0,0.40)" }
  },
  "icon": {
    "$description": "Phosphor Icons, Regular weight. Custom icons drawn on a 256x256 box with a 16px stroke, round caps and joins.",
    "set":      { "$value": "phosphor" },
    "weight":   { "$value": "regular" },
    "grid":     { "$value": "256" },
    "stroke":   { "$value": "16" }
  }
}
